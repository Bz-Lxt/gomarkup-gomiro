# GoMiro environment (copy to .env if running outside compose)
TZ=Asia/Shanghai
HTTP_ADDR=:8080
NODE_ID=node-local
DATABASE_URL=postgres://gomiro:gomiro@127.0.0.1:15432/gomiro?sslmode=disable
REDIS_ADDR=127.0.0.1:16379
REDIS_PASSWORD=
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=5242880
ROOM_IDLE_SEC=45
SNAPSHOT_INTERVAL_SEC=5
LOG_LEVEL=info
WS_ORIGIN=*
PROTO_VERSION=1
MAX_OP_PER_SEC=200
MAX_MSG_BYTES=262144
EMPTY_ROOM_GRACE_SEC=20
PING_INTERVAL_SEC=30
PONG_WAIT_SEC=60
WRITE_WAIT_SEC=10
SEND_QUEUE_SIZE=256
CURSOR_TICK_MS=33
BCRYPT_COST=10
